---
/**
 * superlibrary.dev — the public page.
 *
 * One page, no framework, no scripts. Its job is to explain the product to somebody who
 * typed the domain, and then send them to the docs, the CLI or the source.
 *
 * This directory is deliberately outside the pnpm workspace and has its own npm lockfile,
 * as superwitness's landing does: nothing here should share a dependency tree with the
 * Workers or the web app.
 *
 * Every claim on this page is a `verified` or `limited` entry in sjl-marketing's ledger
 * (foundation/products.md, ## Superlibrary, SL-01…SL-11), and each limited claim keeps its
 * caveat on the page — see "Where it runs today". If a claim changes there, change it here.
 *
 * Every label in the hero is real. The hero is an ItemSummary (packages/contract/src/model.ts):
 *   id            itm_ + 16 hex
 *   kind          'artifact' | 'work-record'
 *   outcome       one of OUTCOMES: approved, completed, rejected, failed, abandoned,
 *                 superseded, in-progress
 *   scope         'workspace' | 'board:brd_' + 16 hex
 *   latestVersion, source, caption
 * The related rows are what library_related returns for it. The MCP tool names are the three
 * apps/api registers; the CLI line is the README's installer.
 *
 * Colours and faces are listed once, in `:root` below; docs-site/src/styles/theme.css uses
 * the same values. The coral is the mark's own; it is spent on the outcome of a piece of
 * work — the thing the library exists to remember — and on actions.
 */
import Mark from '../components/Mark.astro';
import ShareMeta from '../components/ShareMeta.astro';

const DOCS = 'https://docs.superlibrary.dev';
const REPO = 'https://github.com/SuperJackfruitLabs/superlibrary';
const VERSION = 'v0.0.1'; // the latest release tag; bump with each release
const TITLE = 'Superlibrary — the memory of the stack';
const DESCRIPTION =
  'Superlibrary keeps what agents make and what work has been done, labelled with how each turned out, so agents can look before they work and people can find it again. MIT licensed.';

// Must equal the README's install section and the docs site's install page.
const install = `curl -fsSL ${REPO}/releases/latest/download/install.sh | bash`;

const outcomes = ['approved', 'completed', 'in-progress', 'rejected', 'failed', 'abandoned', 'superseded'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="theme-color" content="#15100e" />
    <ShareMeta title={TITLE} description={DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,600;1,6..72,500&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <style>
      /* Contrast (WCAG 2.x), measured on the grounds they sit on:
           dark   coral-text #ffb59d on #15100e 11.1:1 · body #f3ebe6 · muted #a3958d 6.5:1
                  button text #15100e on #ffb59d 11.1:1
           light  coral-text #b8442a on #fbf7f3 5.1:1 · button #ffffff on #b8442a 5.4:1 ·
                  muted #6b5d55 5.9:1
         The mark's coral #f2704e is 2.7:1 on the light ground, so it is never text there. */
      :root {
        --bg: #15100e; --surface: #1d1714; --inset: #0e0a09; --line: rgba(255,255,255,.08);
        --text: #f3ebe6; --muted: #a3958d; --coral: #f2704e; --coral-text: #ffb59d;
        --coral-tint: rgba(242,112,78,.16); --btn: #ffb59d; --btn-ink: #15100e; --code: #e0d6d0;
        --ok: #7fd6a8; --ok-tint: rgba(127,214,168,.14); --no: #f19a9a; --no-tint: rgba(241,154,154,.14);
        --display: 'Newsreader', Georgia, serif; --sans: 'IBM Plex Sans', system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;
        color-scheme: dark light;
      }
      @media (prefers-color-scheme: light) {
        :root {
          --bg: #fbf7f3; --surface: #ffffff; --inset: #f4ece6; --line: rgba(29,23,20,.1);
          --text: #1d1714; --muted: #6b5d55; --coral: #f2704e; --coral-text: #b8442a;
          --coral-tint: rgba(242,112,78,.14); --btn: #b8442a; --btn-ink: #ffffff; --code: #3d342f;
          --ok: #1f7a4d; --ok-tint: rgba(31,122,77,.1); --no: #a8322f; --no-tint: rgba(168,50,47,.08);
        }
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: var(--bg); color: var(--text);
        font-family: var(--sans); font-size: 17px; line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      a:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; border-radius: 4px; }
      .mono { font-family: var(--mono); }
      .muted { color: var(--muted); }
      .wrap { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 24px; }

      /* ── masthead ── */
      header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 24px; padding-bottom: 24px; }
      .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
      .brand .name { font-family: var(--display); font-weight: 600; font-size: 23px; letter-spacing: -0.01em; }
      nav { display: flex; gap: 20px; align-items: center; font-size: 15px; }
      nav a { color: var(--muted); text-decoration: none; }
      nav a:hover { color: var(--text); }
      nav .ver { font-family: var(--mono); font-size: 12.5px; padding: 2px 8px; border: 1px solid var(--line); border-radius: 999px; }

      /* ── hero ── */
      .hero .wrap { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; padding-top: 56px; padding-bottom: 88px; }
      .hero .wrap > * { min-width: 0; }
      h1 { font-family: var(--display); font-weight: 600; font-size: clamp(2.7rem, 6vw, 4.5rem); line-height: 1.02; letter-spacing: -0.02em; margin: 0 0 22px; text-wrap: balance; }
      h1 em { font-style: italic; font-weight: 500; color: var(--coral-text); }
      .lede { color: var(--muted); font-size: 1.1rem; margin: 0 0 30px; max-width: 32em; }
      .cta { display: flex; gap: 12px; flex-wrap: wrap; }
      .btn { display: inline-flex; align-items: center; border-radius: 8px; padding: 11px 19px; font-size: 15px; font-weight: 600; text-decoration: none; border: 1px solid transparent; transition: filter .15s, border-color .15s; }
      .btn-primary { background: var(--btn); color: var(--btn-ink); }
      .btn-primary:hover { filter: brightness(1.06); }
      .btn-ghost { border-color: var(--line); color: var(--text); }
      .btn-ghost:hover { border-color: var(--coral); }

      /* the item card: this page's signature */
      .hero { overflow-x: clip; }
      .card-wrap { position: relative; margin: 0; }
      .card-wrap::before { content: ''; position: absolute; inset: -40px -30px; z-index: 0; pointer-events: none; background: radial-gradient(closest-side, var(--coral-tint), transparent 75%); opacity: .6; }
      .item { position: relative; z-index: 1; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; box-shadow: 0 24px 48px -24px rgba(0,0,0,.45); font-size: 14px; }
      @media (prefers-color-scheme: light) { .item { box-shadow: 0 24px 48px -28px rgba(29,23,20,.22); } }
      .item-head { padding: 16px 18px 12px; border-bottom: 1px solid var(--line); }
      .item-head .ttl { font-family: var(--display); font-weight: 600; font-size: 21px; letter-spacing: -0.01em; line-height: 1.25; }
      .item-head .id { font-family: var(--mono); font-size: 11.5px; color: var(--muted); }
      .item dl { margin: 0; padding: 4px 18px; }
      .row { display: flex; align-items: center; justify-content: space-between; gap: 6px 14px; flex-wrap: wrap; padding: 9px 0; border-bottom: 1px dashed var(--line); }
      .row:last-child { border-bottom: 0; }
      .row dt { font-family: var(--mono); font-size: 12.5px; color: var(--muted); }
      .row dd { margin: 0; display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
      .pill { font-family: var(--mono); font-size: 12px; padding: 2px 8px; border-radius: 6px; background: var(--inset); color: var(--text); white-space: nowrap; }
      .pill.coral { background: var(--coral-tint); color: var(--coral-text); }
      .related { margin: 0; padding: 12px 18px 14px; border-top: 1px solid var(--line); background: var(--inset); }
      .related .lbl { font-family: var(--mono); font-size: 11.5px; color: var(--muted); display: block; margin-bottom: 6px; }
      .related ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px; font-size: 13.5px; }
      .related li { display: flex; justify-content: space-between; gap: 10px; }
      .o-ok { color: var(--ok); font-family: var(--mono); font-size: 12px; }
      .o-no { color: var(--no); font-family: var(--mono); font-size: 12px; }

      /* ── bands ── */
      section.band { border-top: 1px solid var(--line); }
      section.band .wrap { padding-top: 68px; padding-bottom: 68px; }
      .n { display: block; font-family: var(--mono); font-size: 12px; letter-spacing: .12em; color: var(--muted); margin-bottom: 10px; }
      h2 { font-family: var(--display); font-weight: 600; font-size: clamp(1.7rem, 3.2vw, 2.3rem); line-height: 1.12; letter-spacing: -0.015em; margin: 0 0 14px; text-wrap: balance; }
      .sub { color: var(--muted); margin: 0; max-width: 62ch; font-size: 1.05rem; }
      .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
      .split > * { min-width: 0; }
      .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 34px; }
      .cell { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 20px 20px 18px; display: flex; flex-direction: column; gap: 6px; }
      .cell h3 { font-family: var(--display); font-weight: 600; font-size: 1.25rem; letter-spacing: -0.01em; margin: 0; }
      .cell p { margin: 0; color: var(--muted); font-size: 15.5px; }
      .cell .field { margin-top: auto; padding-top: 12px; font-family: var(--mono); font-size: 12px; color: var(--muted); border-top: 1px dashed var(--line); }
      .outcomes { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
      .outcomes .pill { font-size: 13px; padding: 4px 10px; }
      pre, .codeline { font-family: var(--mono); font-size: 13px; line-height: 1.75; color: var(--code); background: var(--inset); border: 1px solid var(--line); border-radius: 10px; margin: 0; padding: 14px 16px; overflow-x: auto; max-width: 100%; }
      .codeline { display: block; margin-top: 22px; word-spacing: .1em; }
      pre .p { color: var(--muted); user-select: none; }
      ul.facts { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 10px; }
      ul.facts li { position: relative; padding-left: 22px; }
      ul.facts li::before { content: ''; position: absolute; left: 2px; top: .62em; width: 8px; height: 8px; border: 1.5px solid var(--coral); border-radius: 50%; }
      ul.facts code { font-family: var(--mono); font-size: .88em; }
      .more { display: inline-block; margin-top: 14px; font-size: 15px; color: var(--coral-text); text-decoration: none; font-weight: 500; }
      .more:hover { text-decoration: underline; text-underline-offset: 3px; }

      /* ── footer ── */
      footer { border-top: 1px solid var(--line); }
      footer .wrap { display: flex; justify-content: space-between; align-items: center; gap: 14px 24px; flex-wrap: wrap; padding-top: 30px; padding-bottom: 44px; font-size: 14px; color: var(--muted); }
      footer a { color: var(--muted); text-decoration: none; }
      footer a:hover { color: var(--text); }
      .fnav { display: flex; gap: 6px 18px; flex-wrap: wrap; }
      .colophon { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 12.5px; }

      @media (max-width: 899px) {
        .hero .wrap { grid-template-columns: 1fr; gap: 44px; padding-top: 32px; padding-bottom: 64px; }
        .split { grid-template-columns: 1fr; gap: 32px; }
        .grid { grid-template-columns: 1fr; }
      }
      @media (max-width: 480px) {
        .wrap { padding: 0 16px; }
        nav { gap: 14px; }
        section.band .wrap { padding-top: 52px; padding-bottom: 52px; }
        .item dl, .item-head, .related { padding-left: 14px; padding-right: 14px; }
      }
      @media (max-width: 360px) { .brand .name { font-size: 19px; } nav .ver { display: none; } }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="brand" href="/" aria-label="Superlibrary home">
          <Mark size={30} />
          <span class="name">Superlibrary</span>
        </a>
        <nav aria-label="Primary">
          <a href={DOCS}>Docs</a>
          <a href={REPO}>Source</a>
          <a class="ver" href={`${REPO}/releases/tag/${VERSION}`}>{VERSION}</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="hero">
        <div class="wrap">
          <div>
            <h1>The memory <em>of the stack</em>.</h1>
            <p class="lede">
              Superlibrary keeps what agents make and what work has been done, each labelled with how it
              turned out. Agents look before they work; people find it again.
            </p>
            <div class="cta">
              <a class="btn btn-primary" href={DOCS}>Read the docs</a>
              <a class="btn btn-ghost" href={REPO}>Source</a>
            </div>
          </div>

          <figure class="card-wrap" aria-label="An example library item">
            <div class="item">
              <div class="item-head">
                <div class="ttl">Pricing page copy, final</div>
                <span class="id">itm_4f0c2a9e81b7d3c5</span>
              </div>
              <dl>
                <div class="row"><dt>kind</dt><dd><span class="pill">artifact</span></dd></div>
                <div class="row"><dt>outcome</dt><dd><span class="pill coral">approved</span></dd></div>
                <div class="row"><dt>scope</dt><dd><span class="pill">board:brd_9a41…</span></dd></div>
                <div class="row"><dt>version</dt><dd><span class="pill">3</span></dd></div>
                <div class="row"><dt>source</dt><dd><span class="pill">superpipeline</span></dd></div>
              </dl>
              <div class="related">
                <span class="lbl">library_related</span>
                <ul>
                  <li><span>Pricing page copy, draft 2</span><span class="o-no">rejected</span></li>
                  <li><span>Write the pricing page</span><span class="o-ok">completed</span></li>
                </ul>
              </div>
            </div>
          </figure>
        </div>
      </div>

      <section class="band" aria-labelledby="o">
        <div class="wrap">
          <span class="n">01</span>
          <h2 id="o">Everything is labelled with how it turned out</h2>
          <p class="sub">
            Files agents produce are kept as artifacts, and the history of a piece of work as a work
            record. Every item carries one of seven outcomes, so "what worked last time" is a question
            with an answer.
          </p>
          <div class="outcomes">{outcomes.map((o) => <span class="pill">{o}</span>)}</div>
        </div>
      </section>

      <section class="band" aria-labelledby="s">
        <div class="wrap">
          <span class="n">02</span>
          <h2 id="s">Search that ranks by outcome, and hides nothing</h2>
          <div class="grid">
            <div class="cell">
              <h3>Words and meaning</h3>
              <p>Full-text and vector search together, so an exact phrase and a loose description both find it.</p>
              <span class="field">hybrid retrieval</span>
            </div>
            <div class="cell">
              <h3>Approved first</h3>
              <p>Work that was approved ranks above work that wasn't. Failures still appear, so the lesson isn't lost.</p>
              <span class="field">outcome-aware ranking</span>
            </div>
            <div class="cell">
              <h3>Only what you may see</h3>
              <p>Results are filtered to the boards and workspace the caller can see, for people and agents alike.</p>
              <span class="field">scope</span>
            </div>
          </div>
        </div>
      </section>

      <section class="band" aria-labelledby="a">
        <div class="wrap">
          <span class="n">03</span>
          <h2 id="a">Agents look before they work</h2>
          <p class="sub">
            An MCP server gives an agent three read-only tools: search the library, open an item, and find
            the work related to it. Agents read; people decide what is kept.
          </p>
          <code class="codeline">library_search · library_get · library_related</code>
        </div>
      </section>

      <section class="band" aria-labelledby="k">
        <div class="wrap split">
          <div>
            <span class="n">04</span>
            <h2 id="k">Safe to keep</h2>
            <p class="sub">An agent's output can carry a token it should never have printed. Superlibrary checks before it keeps.</p>
          </div>
          <ul class="facts">
            <li>Every upload is scanned for secrets, and refused if it holds one. An override needs a written reason.</li>
            <li>Size limits on every file and every upload.</li>
            <li>Files are served from a separate content domain, through short-lived signed links.</li>
            <li>Items embed in other pages with <code>@superlibrary/embed</code>.</li>
          </ul>
        </div>
      </section>

      <section class="band" aria-labelledby="w">
        <div class="wrap">
          <span class="n">05</span>
          <h2 id="w">Work history arrives by itself</h2>
          <p class="sub">
            Connected to <a href="https://superpipeline.dev">Superpipeline</a>, finished cards arrive as work
            records with their outcome, through signed events and a backfill for what came before. Files on
            an <a href="https://agentpod.dev">AgentPod</a> station can be linked in as items too.
          </p>
        </div>
      </section>

      <section class="band" aria-labelledby="c">
        <div class="wrap">
          <span class="n">06</span>
          <h2 id="c">One command-line client: <span class="mono">suli</span></h2>
          <p class="sub">
            One binary, installed without sudo, checked against the release's SHA-256 sums. It carries an
            agent skill built in, so the skill always matches the commands of the <span class="mono">suli</span> that wrote it.
          </p>
          <pre aria-label="Install suli" style="margin-top:22px"><code><span class="p">$ </span>{install}{'\n'}<span class="p">$ </span>suli login</code></pre>
          <a class="more" href={`${DOCS}/install/`}>Install guide →</a>
        </div>
      </section>

      <section class="band" aria-labelledby="r">
        <div class="wrap">
          <span class="n">07</span>
          <h2 id="r">Where it runs today</h2>
          <ul class="facts">
            <li>Cloudflare Workers, with D1, R2, Workers AI, Vectorize and Queues. Local development needs no Cloudflare account.</li>
            <li>People sign in through Super Jackfruit Labs accounts; there is no other sign-in provider yet.</li>
            <li>Superpipeline and AgentPod connections need those products and their service credentials.</li>
            <li>MIT licensed. There is no self-hosting guide yet.</li>
          </ul>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <span class="fnav">
          <a href={DOCS}>Documentation</a>
          <a href={REPO}>GitHub</a>
          <a href="https://superjackfruit.com">Super Jackfruit Labs</a>
          <a href="https://superpipeline.dev">Superpipeline</a>
          <a href="https://agentpod.dev">AgentPod</a>
          <a href="https://superwitness.dev">Superwitness</a>
        </span>
        <span class="colophon"><Mark size={16} /> Superlibrary · MIT</span>
      </div>
    </footer>
  </body>
</html>
