---
/**
 * superlibrary.dev — the public page.
 *
 * One page, no framework, one tiny theme script. Its job is to say what SuperLibrary is to
 * somebody who typed the domain, and send them to the docs.
 *
 * This directory is deliberately outside the pnpm workspace and has its own npm lockfile.
 *
 * Every claim on this page is a `verified` or `limited` entry in sjl-marketing's ledger
 * (foundation/products.md, ## SuperLibrary), and each limited claim keeps its caveat in the
 * same section. The repository is private: no Source link, no licence line and no install
 * command that would 404 until it is public (SL-12). The shared frame adds the claims list,
 * the suite links and the version, so this page does not repeat them.
 *
 * The hero is an invented example ItemSummary (packages/contract/src/model.ts); its labels
 * are real field names and values. The MCP tool names are the three apps/api registers.
 */
import Mark from '../components/Mark.astro';
import ShareMeta from '../components/ShareMeta.astro';

const DOCS = 'https://docs.superlibrary.dev';
const APP = 'https://app.superlibrary.dev';
const VERSION = 'v0.0.1'; // the latest release tag, as the ledger states it; bump with each release
const TITLE = 'SuperLibrary — what agents made, and how it turned out';
const DESCRIPTION =
  'SuperLibrary keeps the files agents make and the record of finished work, each labelled with its outcome, so people and agents can search for what worked before.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="theme-color" content="#15100e" />
    <ShareMeta title={TITLE} description={DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,600;1,6..72,500&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <script is:inline>
      try { var t = localStorage.getItem('theme'); } catch (e) {}
      document.documentElement.dataset.theme = t === 'light' || t === 'dark' ? t : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    </script>
    <style>
      /* Contrast (WCAG 2.x), measured on the grounds they sit on:
           dark   coral-text #ffb59d on #15100e 11.1:1 · body #f3ebe6 · muted #a3958d 6.5:1
                  button text #15100e on #ffb59d 11.1:1
           light  coral-text #b8442a on #fbf7f3 5.1:1 · button #ffffff on #b8442a 5.4:1 ·
                  muted #6b5d55 5.9:1
         The mark's coral #f2704e is 2.7:1 on the light ground, so it is never text there. */
      :root {
        --bg: #15100e; --surface: #1d1714; --inset: #0e0a09; --line: rgba(255,255,255,.08);
        --text: #f3ebe6; --muted: #a3958d; --coral: #f2704e; --coral-text: #ffb59d;
        --coral-tint: rgba(242,112,78,.16); --btn: #ffb59d; --btn-ink: #15100e; --code: #e0d6d0;
        --ok: #7fd6a8; --ok-tint: rgba(127,214,168,.14); --no: #f19a9a; --no-tint: rgba(241,154,154,.14);
        --display: 'Newsreader', Georgia, serif; --sans: 'IBM Plex Sans', system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;
        color-scheme: dark light;
      }
      :root[data-theme="light"] {
          --bg: #fbf7f3; --surface: #ffffff; --inset: #f4ece6; --line: rgba(29,23,20,.1);
          --text: #1d1714; --muted: #6b5d55; --coral: #f2704e; --coral-text: #b8442a;
          --coral-tint: rgba(242,112,78,.14); --btn: #b8442a; --btn-ink: #ffffff; --code: #3d342f;
          --ok: #1f7a4d; --ok-tint: rgba(31,122,77,.1); --no: #a8322f; --no-tint: rgba(168,50,47,.08);
          color-scheme: light;
      }
      :root[data-theme="dark"] { color-scheme: dark; }
      /* no script: follow the system */
      @media (prefers-color-scheme: light) {
        :root:not([data-theme]) {
          --bg: #fbf7f3; --surface: #ffffff; --inset: #f4ece6; --line: rgba(29,23,20,.1);
          --text: #1d1714; --muted: #6b5d55; --coral: #f2704e; --coral-text: #b8442a;
          --coral-tint: rgba(242,112,78,.14); --btn: #b8442a; --btn-ink: #ffffff; --code: #3d342f;
          --ok: #1f7a4d; --ok-tint: rgba(31,122,77,.1); --no: #a8322f; --no-tint: rgba(168,50,47,.08);
        }
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: var(--bg); color: var(--text);
        font-family: var(--sans); font-size: 17px; line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      a:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; border-radius: 4px; }
      .mono { font-family: var(--mono); }
      .muted { color: var(--muted); }
      .wrap { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 24px; }

      /* ── masthead ── */
      header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 24px; padding-bottom: 24px; }
      .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
      .brand .name { font-family: var(--display); font-weight: 600; font-size: 23px; letter-spacing: -0.01em; }
      nav { display: flex; gap: 20px; align-items: center; font-size: 15px; }
      nav a { color: var(--muted); text-decoration: none; }
      nav a:hover { color: var(--text); }
      nav .ver { font-family: var(--mono); font-size: 12.5px; padding: 2px 8px; border: 1px solid var(--line); border-radius: 999px; }

      #theme { background: none; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font: 500 13px var(--sans); padding: 4px 10px; cursor: pointer; }
      #theme:hover { color: var(--text); border-color: var(--coral); }
      #theme:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; }
      ol.steps { list-style: none; counter-reset: s; margin: 30px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
      ol.steps li { counter-increment: s; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 20px; }
      ol.steps li::before { content: counter(s, decimal-leading-zero); display: block; font-family: var(--mono); font-size: 12px; color: var(--coral-text); margin-bottom: 8px; }
      ol.steps h3 { font-family: var(--display); font-weight: 600; font-size: 1.2rem; margin: 0 0 6px; }
      ol.steps p { margin: 0; color: var(--muted); font-size: 15.5px; }
      .prose p { margin: 0 0 14px; max-width: 64ch; }
      .prose code, .sub code { font-family: var(--mono); font-size: .88em; }
      figcaption { margin-top: 12px; font-size: 13px; color: var(--muted); text-align: center; position: relative; z-index: 1; }

      /* ── hero ── */
      .hero .wrap { display: grid; grid-template-columns: minmax(0, 1fr) 500px; gap: 56px; align-items: center; min-height: calc(100svh - 108px); padding-top: 56px; padding-bottom: 72px; }
      .hero .wrap > * { min-width: 0; }
      h1 { font-family: var(--display); font-weight: 600; font-size: clamp(40px, 4.6vw, 60px); line-height: 1.04; letter-spacing: -0.02em; margin: 0; max-width: 12ch; text-wrap: balance; }
      h1 em { font-style: italic; font-weight: 500; color: var(--coral-text); }
      .lede { color: var(--muted); font-family: var(--sans); font-size: 18px; line-height: 1.55; margin: 20px 0 28px; max-width: 34em; }
      .cta { display: flex; gap: 12px; flex-wrap: wrap; }
      .btn { display: inline-flex; align-items: center; height: 46px; border-radius: 10px; padding: 0 20px; font: 600 15px var(--sans); text-decoration: none; border: 1px solid transparent; transition: filter .15s, border-color .15s; }
      .btn-primary { background: var(--btn); color: var(--btn-ink); }
      .btn-primary:hover { filter: brightness(1.06); }
      .btn-ghost { background: transparent; border-color: var(--line); color: var(--text); }
      .btn-ghost:hover { border-color: var(--coral); }

      /* the item card: this page's signature */
      .hero { overflow-x: clip; }
      .card-wrap { position: relative; margin: 0; width: 500px; max-width: 100%; }
      .card-wrap figcaption { margin-top: 10px; font: 12px var(--mono); color: var(--muted); }
      .card-wrap::before { content: ''; position: absolute; inset: -40px -30px; z-index: 0; pointer-events: none; background: radial-gradient(closest-side, var(--coral-tint), transparent 75%); opacity: .6; }
      .item { position: relative; z-index: 1; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; box-shadow: 0 24px 48px -24px rgba(0,0,0,.45); font-size: 14px; }
      [data-theme="light"] .item { box-shadow: 0 24px 48px -28px rgba(29,23,20,.22); }
      .item-head { padding: 16px 18px 12px; border-bottom: 1px solid var(--line); }
      .item-head .ttl { font-family: var(--display); font-weight: 600; font-size: 21px; letter-spacing: -0.01em; line-height: 1.25; }
      .item-head .id { font-family: var(--mono); font-size: 11.5px; color: var(--muted); }
      .item dl { margin: 0; padding: 4px 18px; }
      .row { display: flex; align-items: center; justify-content: space-between; gap: 6px 14px; flex-wrap: wrap; padding: 9px 0; border-bottom: 1px dashed var(--line); }
      .row:last-child { border-bottom: 0; }
      .row dt { font-family: var(--mono); font-size: 12.5px; color: var(--muted); }
      .row dd { margin: 0; display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
      .pill { font-family: var(--mono); font-size: 12px; padding: 2px 8px; border-radius: 6px; background: var(--inset); color: var(--text); white-space: nowrap; }
      .pill.coral { background: var(--coral-tint); color: var(--coral-text); }
      .related { margin: 0; padding: 12px 18px 14px; border-top: 1px solid var(--line); background: var(--inset); }
      .related .lbl { font-family: var(--mono); font-size: 11.5px; color: var(--muted); display: block; margin-bottom: 6px; }
      .related ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px; font-size: 13.5px; }
      .related li { display: flex; justify-content: space-between; gap: 10px; }
      .o-ok { color: var(--ok); font-family: var(--mono); font-size: 12px; }
      .o-no { color: var(--no); font-family: var(--mono); font-size: 12px; }

      /* ── bands ── */
      section.band { border-top: 1px solid var(--line); }
      section.band .wrap { padding-top: 68px; padding-bottom: 68px; }
      .n { display: block; font-family: var(--mono); font-size: 12px; letter-spacing: .12em; color: var(--muted); margin-bottom: 10px; }
      h2 { font-family: var(--display); font-weight: 600; font-size: clamp(1.7rem, 3.2vw, 2.3rem); line-height: 1.12; letter-spacing: -0.015em; margin: 0 0 14px; text-wrap: balance; }
      .sub { color: var(--muted); margin: 0; max-width: 62ch; font-size: 1.05rem; }
      .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
      .split > * { min-width: 0; }
      .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 34px; }
      .cell { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 20px 20px 18px; display: flex; flex-direction: column; gap: 6px; }
      .cell h3 { font-family: var(--display); font-weight: 600; font-size: 1.25rem; letter-spacing: -0.01em; margin: 0; }
      .cell p { margin: 0; color: var(--muted); font-size: 15.5px; }
      .cell .field { margin-top: auto; padding-top: 12px; font-family: var(--mono); font-size: 12px; color: var(--muted); border-top: 1px dashed var(--line); }
      .outcomes { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
      .outcomes .pill { font-size: 13px; padding: 4px 10px; }
      pre, .codeline { font-family: var(--mono); font-size: 13px; line-height: 1.75; color: var(--code); background: var(--inset); border: 1px solid var(--line); border-radius: 10px; margin: 0; padding: 14px 16px; overflow-x: auto; max-width: 100%; }
      .codeline { display: block; margin-top: 22px; word-spacing: .1em; }
      pre .p { color: var(--muted); user-select: none; }
      ul.facts { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 10px; }
      ul.facts li { position: relative; padding-left: 22px; }
      ul.facts li::before { content: ''; position: absolute; left: 2px; top: .62em; width: 8px; height: 8px; border: 1.5px solid var(--coral); border-radius: 50%; }
      ul.facts code { font-family: var(--mono); font-size: .88em; }
      .more { display: inline-block; margin-top: 14px; font-size: 15px; color: var(--coral-text); text-decoration: none; font-weight: 500; }
      .more:hover { text-decoration: underline; text-underline-offset: 3px; }

      /* ── footer ── */
      footer { border-top: 1px solid var(--line); }
      footer .wrap { display: flex; justify-content: space-between; align-items: center; gap: 14px 24px; flex-wrap: wrap; padding-top: 30px; padding-bottom: 44px; font-size: 14px; color: var(--muted); }
      footer a { color: var(--muted); text-decoration: none; }
      footer a:hover { color: var(--text); }
      .fnav { display: flex; gap: 6px 18px; flex-wrap: wrap; }
      .colophon { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 12.5px; }

      @media (max-width: 899px) {
        .hero .wrap { grid-template-columns: 1fr; gap: 44px; min-height: auto; padding-top: 40px; padding-bottom: 56px; }
        .card-wrap { width: 100%; }
        .split { grid-template-columns: 1fr; gap: 32px; }
        .grid, ol.steps { grid-template-columns: 1fr; }
      }
      @media (max-width: 480px) {
        .wrap { padding: 0 16px; }
        nav { gap: 14px; }
        section.band .wrap { padding-top: 52px; padding-bottom: 52px; }
        .item dl, .item-head, .related { padding-left: 14px; padding-right: 14px; }
      }
      @media (max-width: 360px) { .brand .name { font-size: 19px; } nav .ver { display: none; } }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="brand" href="/" aria-label="SuperLibrary home">
          <Mark size={30} />
          <span class="name">SuperLibrary</span>
        </a>
        <nav aria-label="Primary">
          <a href={DOCS}>Docs</a>
          <span class="ver">{VERSION}</span>
          <button id="theme" type="button" aria-label="Switch light and dark theme">Theme</button>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap">
          <div>
            <h1>Find what agents made, and <em>whether it worked.</em></h1>
            <p class="lede">
              SuperLibrary keeps the files agents make and the record of finished work, each labelled with
              its outcome, and lets people and agents search them.
            </p>
            <div class="cta">
              <a class="btn btn-primary" href={`${DOCS}/install/`}>Get started</a>
              <a class="btn btn-ghost" href={DOCS}>Docs</a>
            </div>
          </div>

          <figure class="card-wrap">
            <div class="item">
              <div class="item-head">
                <div class="ttl">Pricing page copy, final</div>
                <span class="id">itm_4f0c2a9e81b7d3c5</span>
              </div>
              <dl>
                <div class="row"><dt>kind</dt><dd><span class="pill">artifact</span></dd></div>
                <div class="row"><dt>outcome</dt><dd><span class="pill coral">approved</span></dd></div>
                <div class="row"><dt>scope</dt><dd><span class="pill">board:brd_9a41…</span></dd></div>
                <div class="row"><dt>version</dt><dd><span class="pill">3</span></dd></div>
                <div class="row"><dt>source</dt><dd><span class="pill">superpipeline</span></dd></div>
              </dl>
              <div class="related">
                <span class="lbl">library_related</span>
                <ul>
                  <li><span>Pricing page copy, draft 2</span><span class="o-no">rejected</span></li>
                  <li><span>Write the pricing page</span><span class="o-ok">completed</span></li>
                </ul>
              </div>
            </div>
            <figcaption>Example item with invented data. The field names and outcomes are the real ones.</figcaption>
          </figure>
        </div>
      </section>

      <section class="band" aria-labelledby="how">
        <div class="wrap">
          <h2 id="how">How it works</h2>
          <ol class="steps">
            <li>
              <h3>Work comes in, labelled</h3>
              <p>
                Files are uploaded as artifacts, versioned. Each item carries one of seven outcomes: approved,
                completed, in-progress, superseded, rejected, failed or abandoned. Work records come only from
                SuperPipeline, and only once it is connected with a signing key and credentials.
              </p>
            </li>
            <li>
              <h3>Uploads are checked</h3>
              <p>
                Every upload is scanned for common key formats and size limits before it is kept; a refusal names
                the file and line, and an override needs a written reason. It is pattern matching, not a guarantee
                that no secret gets through.
              </p>
            </li>
            <li>
              <h3>Search ranks by outcome</h3>
              <p>
                Full-text and vector search run together. Approved and completed work ranks first; rejected and
                failed work ranks lower but still shows. You only see boards you are on and workspace-wide items.
                Search is text only for now.
              </p>
            </li>
          </ol>
        </div>
      </section>

      <section class="band" aria-labelledby="use">
        <div class="wrap prose">
          <h2 id="use">What it's like to use</h2>
          <p>
            Say an agent is about to write a pricing page. Before it starts, it calls <code>library_search</code>
            through SuperLibrary's MCP server and finds the approved final copy. <code>library_related</code> shows
            the draft that was rejected and the card that completed the work, so it starts from what was accepted
            and knows what was turned down.
          </p>
          <p class="muted">
            The MCP server has three read-only tools: <code>library_search</code>, <code>library_get</code> and
            <code>library_related</code>. An agent needs a session token from your organization's sign-in and has
            to be given the server. Agents can still add files, through <code>suli upload</code>, under the same
            secret scan as anyone else.
          </p>
        </div>
      </section>

      <section class="band" aria-labelledby="run">
        <div class="wrap prose">
          <h2 id="run">Run it yourself</h2>
          <p>
            SuperLibrary runs as a hosted service at <a href={APP}>app.superlibrary.dev</a>. You sign in with an
            account on the Super Jackfruit Labs account service; that sign-in is the only way in today.
          </p>
          <p>
            The command-line client, <code>suli</code>, is one binary for macOS (Apple silicon and Intel) and
            Linux (x64 and arm64), released as {VERSION}. Its installer needs no sudo and checks every download
            against the release's SHA-256 sums. The source and releases are private for now, so the public
            installer command does not work yet; it becomes public with the repository.
            <code>suli login</code> signs in through the same account service, and <code>suli skill install</code>
            gives an agent a skill that matches its commands.
          </p>
          <a class="more" href={`${DOCS}/install/`}>Install guide →</a>
        </div>
      </section>

      <section class="band" aria-labelledby="r">
        <div class="wrap">
          <h2 id="r">Where it runs today</h2>
          <ul class="facts">
            <li>Only on Cloudflare Workers (D1, R2, Workers AI, Vectorize, Queues). There is no self-hosting guide, and the configuration names SJL's own domains.</li>
            <li>Sign-in goes through SJL's account service; a self-hosted copy has no other sign-in provider yet.</li>
            <li>The viewer can be embedded with <code>@superlibrary/embed</code>, but only on pages from origins in its configuration, which today are SJL's own.</li>
            <li>Work records need SuperPipeline; linked station files need an AgentPod hub. Neither arrives without that setup.</li>
            <li>The source is private. It will be published later; until then there is no licence to point to.</li>
          </ul>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <span class="fnav">
          <a href={DOCS}>Docs</a>
          <a href="https://superjackfruit.com">Super Jackfruit Labs</a>
        </span>
        <span class="colophon"><Mark size={16} /> SuperLibrary</span>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var b = document.getElementById('theme'), h = document.documentElement;
        b.addEventListener('click', function () {
          var t = h.dataset.theme === 'light' ? 'dark' : 'light';
          h.dataset.theme = t;
          try { localStorage.setItem('theme', t); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
