/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Spelled out rather than left to extension mapping: an install prompt ignores a manifest served
# as anything but application/manifest+json.
/manifest.webmanifest
  Content-Type: application/manifest+json

# Spelled out too: every response carries nosniff, so a favicon.ico without its type is not drawn.
/favicon.ico
  Content-Type: image/x-icon
