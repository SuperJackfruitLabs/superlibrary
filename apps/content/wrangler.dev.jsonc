{
  // Local dev and e2e (`pnpm dev`): wrangler.jsonc without "routes", so `itm-<hex>.localhost` reaches
  // the Worker under its own name. Keep everything else identical (packages/contract/test/repo-invariants.test.ts).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "superlibrary-content",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
  "vars": {
    "FRAME_ANCESTORS": "https://app.superlibrary.dev https://app.superpipeline.dev https://console.agentpod.dev",
    "CONTENT_DOMAIN": "superlibrarycontent.dev"
  },
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "superlibrary-blobs" }],
  "assets": { "directory": "./viewer-dist", "binding": "VIEWER", "run_worker_first": true },
  // The staging plane's content Worker (superlibrary-content-staging), deployed by the API's staging
  // deploy (deploy/staging/deploy.sh). Item hosts are `<label>-stg.superlibrarycontent.dev`: one label,
  // so Universal SSL covers them, and a route more specific than production's.
  "env": {
    "staging": {
      "observability": { "enabled": false },
      "vars": {
        "FRAME_ANCESTORS": "https://staging-app.superlibrary.dev https://staging-app.superpipeline.dev https://staging-console.agentpod.dev",
        "CONTENT_DOMAIN": "-stg.superlibrarycontent.dev"
      },
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "superlibrary-blobs-staging" }],
      "assets": { "directory": "./viewer-dist", "binding": "VIEWER", "run_worker_first": true },
      "routes": [{ "pattern": "*-stg.superlibrarycontent.dev/*", "zone_name": "superlibrarycontent.dev" }]
    }
  }
}
