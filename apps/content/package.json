{
  "name": "@superlibrary/content",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:viewer": "vite build -c viewer/vite.config.ts",
    "test": "pnpm build:viewer && vitest run && vitest run -c viewer/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p viewer",
    "dev": "pnpm build:viewer && wrangler dev -c wrangler.dev.jsonc --port 8788 --var CONTENT_DOMAIN:localhost --var FRAME_ANCESTORS:http://localhost:5173",
    "deploy": "pnpm build:viewer && wrangler deploy"
  },
  "dependencies": {
    "@superlibrary/contract": "workspace:*",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "18.1.0",
    "mermaid": "12.1.0",
    "pdfjs-dist": "^4.10.38",
    "smol-toml": "^1.9.0",
    "viz.js": "2.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@cloudflare/workers-types": "^4.20260619.1",
    "jsdom": "^30.1.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "wrangler": "^4.103.0"
  }
}
