{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "superlibrary-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The routes are the only intended origins: no *.workers.dev name, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // Run next to the catalog and the bytes (D1 primary and R2 bucket are both in APAC, Singapore).
  // Every request makes several D1 and R2 calls one after another; served from the colo nearest
  // the caller, each call crossed continents (~150-250 ms, measured), so a request paid the
  // crossing many times. Placed here, it pays it once. Applies to fetch only (cron/queue unchanged).
  "placement": { "region": "aws:ap-southeast-1" },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
  // DEV_AUTH is deliberately NOT set here (Superpipeline's rule): dev headers are a full credential,
  // opted into by `pnpm dev` and the test runner only.
  "vars": {
    // The Organization plane (accounts issuer contract §1). Plain vars, not secrets: they name whom to
    // believe and grant nothing. Changed only through a merged PR.
    "ORG_PLANE_ISSUER": "https://accounts.superjackfruit.com",
    "ORG_PLANE_JWKS_URL": "https://accounts.superjackfruit.com/api/auth/jwks",
    "ORG_PLANE_AUDIENCE": "https://app.superlibrary.dev",
    // This deployment's own origin: the audience, the item links, the default frame host.
    "APP_URL": "https://app.superlibrary.dev",
    "CONTENT_ORIGIN_TEMPLATE": "https://{label}.superlibrarycontent.dev",
    // Other products that may mint embed URLs from the browser (spec §9, Embedding). Must equal the
    // content Worker's FRAME_ANCESTORS minus APP_URL; a test added with the content Worker holds the two together.
    "EMBED_HOSTS": "https://app.superpipeline.dev https://console.agentpod.dev",
    // Browser origins that call the upload routes and the station list with the person's own token
    // (ruling RA3: the AgentPod console links a file as the signed-in person, never through the hub).
    "CONSOLE_ORIGINS": "https://console.agentpod.dev",
    // Plan decision D14: "report" until phase 2 brings references; then "enforce".
    "RETENTION_MODE": "report",
    // Plan Stage 0. Names whom to call; grant nothing. Secrets (HUB_SERVICE_PRINCIPAL, SERVICE_CREDENTIALS,
    // PUSH_SIGNING_KEY, OPERATORS) are set with `wrangler secret put`, never here.
    "ORG_PLANE_URL": "https://accounts.superjackfruit.com",
    "HUB_URL": "https://hub.agentpod.dev",
    "HUB_AUDIENCE": "https://hub.agentpod.dev",
    "SUPERPIPELINE_URL": "https://app.superpipeline.dev",
    "SUPERPIPELINE_AUDIENCE": "https://app.superpipeline.dev",
    "ROSTER_TTL_SECONDS": "300"
  },
  // URL_SIGNING_PRIVATE_KEY is a secret: `wrangler secret put URL_SIGNING_PRIVATE_KEY` (Task 21 Step 4).
  "d1_databases": [
    { "binding": "DB", "database_name": "superlibrary-catalog", "database_id": "baecb101-9eb3-4e84-bbe2-8037b1ab2b3f", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "superlibrary-blobs" }],
  // Spec §7 / plan P9. Slot b is idle until a re-index fills it (Task B8).
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "VEC_A", "index_name": "superlibrary-chunks-a" },
    { "binding": "VEC_B", "index_name": "superlibrary-chunks-b" }
  ],
  "queues": {
    "producers": [
      { "binding": "RETENTION", "queue": "superlibrary-retention" },
      { "binding": "INGEST", "queue": "superlibrary-ingest" },
      { "binding": "INDEX", "queue": "superlibrary-index" }
    ],
    "consumers": [
      { "queue": "superlibrary-retention", "max_batch_size": 1, "max_retries": 5 },
      { "queue": "superlibrary-index", "max_batch_size": 2, "max_batch_timeout": 5, "max_retries": 8, "max_concurrency": 2 },
      // max_concurrency 1: two invocations could read a card at different times and write in the
      // opposite order, leaving the older read as the record. One at a time keeps the order.
      { "queue": "superlibrary-ingest", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 8, "max_concurrency": 1 }
    ]
  },
  // The daily sweep enqueues one message; the consumer does the work (spec §6 `retention` queue).
  // The daily reconcile (spec §7) runs at 03:30; the hourly cron re-registers the Superpipeline push configs (Task A11).
  "triggers": { "crons": ["0 3 * * *", "30 3 * * *", "0 * * * *"] },
  // Same hostname as the Pages app (plan decision D1). Declared here, not clicked in the dashboard.
  "routes": [
    { "pattern": "app.superlibrary.dev/api/*", "zone_name": "superlibrary.dev" },
    { "pattern": "app.superlibrary.dev/.well-known/oauth-protected-resource", "zone_name": "superlibrary.dev" },
    { "pattern": "app.superlibrary.dev/mcp", "zone_name": "superlibrary.dev" },
    { "pattern": "app.superlibrary.dev/.well-known/oauth-protected-resource/mcp", "zone_name": "superlibrary.dev" }
  ],
  // The staging plane (workbench; deploy/staging/): `wrangler dev --env staging`, never deployed.
  // Every binding is local (D1, R2, Queues persisted in the box's `state` volume) except the two
  // with no local simulation: Workers AI and Vectorize, which reach Cloudflare ("remote": true),
  // Vectorize on its own staging indexes. Production's top-level config above is unchanged.
  "env": {
    "staging": {
      "routes": [],
      "observability": { "enabled": false },
      // One host serves the SPA (apps/web/build) and, first, the Worker's own paths: production's
      // routes, plus /__scheduled for `--test-scheduled` (the edge refuses that path from outside).
      "assets": {
        "directory": "../web/build",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/mcp", "/.well-known/oauth-protected-resource", "/.well-known/oauth-protected-resource/*", "/__scheduled"]
      },
      "vars": {
        "ORG_PLANE_ISSUER": "https://staging-accounts.superjackfruit.com",
        "ORG_PLANE_JWKS_URL": "https://staging-accounts.superjackfruit.com/api/auth/jwks",
        "ORG_PLANE_AUDIENCE": "https://staging-app.superlibrary.dev",
        "APP_URL": "https://staging-app.superlibrary.dev",
        // Item hosts need a wildcard certificate staging does not have; the content Worker runs on
        // the box with this domain, but item origins are not reachable from outside.
        "CONTENT_ORIGIN_TEMPLATE": "https://{label}.staging-content.superlibrary.dev",
        "EMBED_HOSTS": "https://staging-app.superpipeline.dev https://staging-console.agentpod.dev",
        "CONSOLE_ORIGINS": "https://staging-console.agentpod.dev",
        "RETENTION_MODE": "report",
        "ORG_PLANE_URL": "https://staging-accounts.superjackfruit.com",
        "HUB_URL": "https://staging-hub.agentpod.dev",
        "HUB_AUDIENCE": "https://staging-hub.agentpod.dev",
        "SUPERPIPELINE_URL": "https://staging-app.superpipeline.dev",
        "SUPERPIPELINE_AUDIENCE": "https://staging-app.superpipeline.dev",
        "ROSTER_TTL_SECONDS": "300"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "superlibrary-catalog-staging", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      // Local. The name matches the content Worker's, which reads the same persisted bucket.
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "superlibrary-blobs" }],
      "ai": { "binding": "AI", "remote": true },
      "vectorize": [
        { "binding": "VEC_A", "index_name": "superlibrary-chunks-a-staging", "remote": true },
        { "binding": "VEC_B", "index_name": "superlibrary-chunks-b-staging", "remote": true }
      ],
      "queues": {
        "producers": [
          { "binding": "RETENTION", "queue": "superlibrary-retention" },
          { "binding": "INGEST", "queue": "superlibrary-ingest" },
          { "binding": "INDEX", "queue": "superlibrary-index" }
        ],
        "consumers": [
          { "queue": "superlibrary-retention", "max_batch_size": 1, "max_retries": 5 },
          { "queue": "superlibrary-index", "max_batch_size": 2, "max_batch_timeout": 5, "max_retries": 8, "max_concurrency": 2 },
          { "queue": "superlibrary-ingest", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 8, "max_concurrency": 1 }
        ]
      },
      // Fired by the `cron` sidecar in deploy/staging/compose.yml; workerd fires none on its own.
      "triggers": { "crons": ["0 3 * * *", "30 3 * * *", "0 * * * *"] }
    }
  }
}
